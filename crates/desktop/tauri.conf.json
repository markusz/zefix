{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zefix!",
  "mainBinaryName": "zefix",
  "identifier": "de.markusziller.zefix",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../../web" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../../web" }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "zefix!",
        "width": 1440,
        "height": 920,
        "minWidth": 380,
        "minHeight": 560
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "public.app-category.board-games",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"]
  }
}
